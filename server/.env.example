# Copy to .env (never commit .env)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=bdbac
PORT=5000
# Comma-separated list of allowed website origins (your frontend URL). Empty = allow all.
CORS_ORIGIN=http://localhost:5173
RELEASE_NAME=v0.1.0
# Folder with samples.ndjson / projects.ndjson (used by `npm run seed`)
DATA_DIR=../site_data
